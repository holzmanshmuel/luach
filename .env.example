# Luach — environment variables
#
# Copy to .env.local for development (`cp .env.example .env.local`), or set these
# as secrets on your host. .env* is gitignored; never commit real values.

# ─── Database (required) ─────────────────────────────────────────────────────
# Postgres connection string for the app.
#
# ⚠️  POINT THIS AT A RESTRICTED ROLE — NOT the database owner, and NEVER a
#     superuser. Tenant isolation between families is enforced by Postgres
#     row-level security, and Postgres SILENTLY SKIPS row-level security for
#     superusers and for roles with BYPASSRLS. Connecting as `postgres` will not
#     raise an error; it will just let every family read every other family's
#     calendar. Create `app_user` (see README → Self-hosting) and use it here.
#     Migrations are the exception: run those as the owner.
DATABASE_URL=postgres://app_user:your_password_here@localhost:5432/luach

# ─── Session (required) ──────────────────────────────────────────────────────
# Secret that seals the iron-session cookie. Minimum 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_PASSWORD=replace_me_with_at_least_32_random_characters

# ─── Google sign-in (required) ───────────────────────────────────────────────
# An OAuth 2.0 "Web application" client from the Google Cloud console.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me

# The redirect URI, registered byte-for-byte identically in the Google console.
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Public origin (required in production) ──────────────────────────────────
# Absolute origin of your deployment. Used to build invite links, calendar feed
# URLs, and the links inside WhatsApp digests.
#
# ⚠️  The broadcast feeds (/api/digest/week, /api/reminders/yahrzeit) put this
#     link in a message someone reads on their phone, so there is no safe
#     default: both return HTTP 500 naming this variable if it is unset, rather
#     than guessing an origin and messaging your family a link to the wrong
#     calendar.
NEXTAUTH_URL=http://localhost:3000

# ─── Family branches (optional) ──────────────────────────────────────────────
# The "sides" of your family, comma-separated. Used to tint avatars, tree cards
# and timeline entries, and as the key for the per-viewer surname-spelling UI.
# Unset = the fictional demo family below.
#
# ⚠️  ORDER IS THE COLOUR. Branch colours are assigned by POSITION: the first
#     name gets the first palette colour, the second the second, and so on.
#     Reordering reshuffles the colours everyone already recognises — append,
#     never insert or reorder.
# ⚠️  KEEP A CATCH-ALL LAST. The final entry is the "no particular branch"
#     bucket: neutral tint, excluded from the spelling UI, and where the CSV
#     importer files anyone it can't place. Any word will do.
#
# Values already in your database that are not in this list are fine — those
# people render neutral and keep their stored value.
FAMILY_BRANCHES=Levi,Cohen,Mizrahi,Adler,Other

# ─── Automation endpoints (optional) ─────────────────────────────────────────
# Bearer token guarding the machine-readable feeds used by an automation tool
# (n8n or similar): /api/digest/daily, /api/events/today, /api/digest/week,
# /api/reminders/yahrzeit and /api/families. Leave unset to keep those
# endpoints unusable.
#
# ⚠️  DEPLOYMENT SECRET: this token reads ACROSS families. Store it in your
#     host's secret manager, rotate it if it leaks, and never put it in a
#     client-side variable. Generate with: openssl rand -hex 32
N8N_TOKEN=

# The timezone a DAY is reckoned in. /api/digest/daily answers "what is on
# today" and "is today Sunday" in this zone — set it to the family's, or the
# morning digest turns the day over hours early or late (the container default
# is usually UTC).
#
# Set this in the SERVICE environment (Railway variables, `docker run -e TZ=…`),
# not only here — it configures the process clock, not just the app.
# TZ=Asia/Jerusalem

# LEGACY, and only for /api/digest/week + /api/reminders/yahrzeit: extra
# recipients beyond the family members who have a phone number and nudges
# enabled. Comma-separated E.164 numbers.
#
# ⚠️  This list is DEPLOYMENT-WIDE, so it is applied to every family — on a
#     multi-family instance it puts your own phone on other families' private
#     dates. /api/digest/daily deliberately ignores it: whoever wants the
#     digest joins the family as a member with a phone number instead.
# e.g. DIGEST_RECIPIENTS=+14155551234,+441632960123
DIGEST_RECIPIENTS=
